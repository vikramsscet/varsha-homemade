VITE_API_BASE_URL=http://localhost:3000/api/v1

# User & auth microservice (user-and-cart-service) base URL
VITE_USER_SERVICE_URL=http://localhost:3001/api/v1
# Google OAuth Web client ID (public). Must equal GOOGLE_CLIENT_ID in the user service.
# Never put the client secret here. Authorized JavaScript origins in Google Cloud Console must
# include the frontend origin (e.g. http://localhost:5174) and that origin must be in the
# user service CORS_ORIGINS.
VITE_GOOGLE_CLIENT_ID=
